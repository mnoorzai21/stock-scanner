# Copy this file to .env and fill in your keys. Never commit .env.

# Alpaca (https://alpaca.markets): market data, news and the trading calendar.
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key

# Massive, formerly Polygon.io (https://massive.com): share float.
MASSIVE_API_KEY=your_massive_api_key

# Optional settings (defaults shown).
# ALPACA_FEED=iex            # "sip" covers all U.S. exchanges but needs a paid Alpaca data plan
# MIN_PRICE=1
# MAX_PRICE=20
# MIN_CHANGE_PERCENT=20
# MIN_RVOL=5
# MAX_FLOAT=20000000
# NEWS_MAX_AGE_HOURS=24
# SCAN_INTERVAL_MS=60000
# SCAN_IDLE_TIMEOUT_MS=600000
# MASSIVE_MIN_INTERVAL_MS=12500
# DEBUG_SCANNER=false
